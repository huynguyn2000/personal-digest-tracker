<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Morning Digest — {{ generated_local }}</title>
<meta name="description" content="Your morning digest — AWS, data engineering & AI news, deduped and summarized, with FX / weather / air-quality trackers.">
<meta name="theme-color" content="#0b0b0c">
<link rel="icon" href='data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16"><text x="1" y="14" font-size="14">📰</text></svg>'>
<link rel="manifest" href="manifest.webmanifest">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Digest">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<link rel="apple-touch-icon" href="icon-192.png">
<style>
  :root {
    --bg: #ffffff; --fg: #1a1a1a; --muted: #666; --card: #f4f4f5;
    --border: #e4e4e7; --accent: #2563eb; --spark: #2563eb;
    --badge-rss:#0891b2; --badge-youtube:#dc2626; --badge-github:#7c3aed; --badge-imap:#059669;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg:#0b0b0c; --fg:#e7e7ea; --muted:#9a9aa0; --card:#161618;
      --border:#27272a; --accent:#60a5fa; --spark:#60a5fa;
      --badge-rss:#22d3ee; --badge-youtube:#f87171; --badge-github:#c084fc; --badge-imap:#34d399;
    }
  }
  :root[data-theme="dark"] {
    --bg:#0b0b0c; --fg:#e7e7ea; --muted:#9a9aa0; --card:#161618;
    --border:#27272a; --accent:#60a5fa; --spark:#60a5fa;
    --badge-rss:#22d3ee; --badge-youtube:#f87171; --badge-github:#c084fc; --badge-imap:#34d399;
  }
  :root[data-theme="light"] {
    --bg:#ffffff; --fg:#1a1a1a; --muted:#666; --card:#f4f4f5;
    --border:#e4e4e7; --accent:#2563eb; --spark:#2563eb;
    --badge-rss:#0891b2; --badge-youtube:#dc2626; --badge-github:#7c3aed; --badge-imap:#059669;
  }
  * { box-sizing: border-box; }
  body {
    margin:0; background:var(--bg); color:var(--fg);
    font: 16px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }
  .wrap { max-width: 720px; margin: 0 auto; padding: 20px 16px 64px; }
  .topbar { display:flex; justify-content:space-between; align-items:flex-start; gap:12px; }
  header h1 { font-size: 1.3rem; margin: 0 0 2px; text-wrap:balance; }
  header .sub { color: var(--muted); font-size: .85rem; }
  header .sub .fresh::before { content:"· "; }
  .theme-btn { background:var(--card); border:1px solid var(--border); color:var(--fg);
    width:36px; height:36px; border-radius:9px; font-size:16px; cursor:pointer; flex:none; line-height:1; }
  .theme-btn:hover { border-color:var(--accent); }
  .jump { display:flex; flex-wrap:wrap; gap:6px; margin:14px 0 20px; }
  .jump a { font-size:.75rem; text-decoration:none; color:var(--muted); background:var(--card);
    border:1px solid var(--border); border-radius:999px; padding:3px 10px; }
  .jump a:hover { color:var(--accent); border-color:var(--accent); }
  :focus-visible { outline:2px solid var(--accent); outline-offset:2px; border-radius:4px; }
  html { scroll-behavior:smooth; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior:auto; } * { transition:none!important; } }
  .type { scroll-margin-top:12px; }

  #trackers { margin-bottom:26px; }
  .tgroup-label { font-size:.66rem; text-transform:uppercase; letter-spacing:.09em; color:var(--muted); margin:0 0 8px; }
  #trackers .trackers + .tgroup-label { margin-top:16px; }
  .trackers { display:flex; flex-wrap:wrap; gap:10px; margin-bottom:0; }
  .tracker {
    flex:1 1 140px; background:var(--card); border:1px solid var(--border);
    border-radius:12px; padding:10px 12px;
  }
  .tracker .label { color:var(--muted); font-size:.72rem; text-transform:uppercase; letter-spacing:.04em; }
  .tracker .value-row { display:flex; align-items:baseline; gap:8px; flex-wrap:wrap; margin-top:3px; }
  .tracker .value { font-size:1.3rem; font-weight:680; font-variant-numeric:tabular-nums; }
  .tracker .delta { font-size:.72rem; font-variant-numeric:tabular-nums; color:var(--muted); }
  .tracker .delta.up::before, .tracker .delta.down::before { content:""; }
  .tracker .band { display:flex; align-items:center; gap:5px; font-size:.72rem; color:var(--muted); margin-top:5px; }
  .tracker .band .dot { width:8px; height:8px; border-radius:50%; flex:none; }
  .tracker .tsub { color:var(--muted); font-size:.72rem; margin-top:4px; font-variant-numeric:tabular-nums; }
  .tracker .tcond { color:var(--muted); font-size:.72rem; margin-top:4px; }
  .tracker.alert { border-width:2px; padding:9px 11px; }
  .tracker svg.spark { display:block; margin-top:8px; width:100%; height:32px; overflow:visible; }
  .spark-area { fill:var(--accent); opacity:.14; }
  .spark-line { fill:none; stroke:var(--accent); stroke-width:1.6; stroke-linecap:round; stroke-linejoin:round; }
  .spark-dot { fill:var(--accent); }

  h2.section { font-size:.8rem; text-transform:uppercase; letter-spacing:.06em;
    color:var(--muted); border-bottom:1px solid var(--border); padding-bottom:6px; margin:28px 0 10px; }

  .item { padding:12px 0; border-bottom:1px solid var(--border); }
  .item:last-child { border-bottom:none; }
  .item .top { display:flex; align-items:baseline; gap:8px; flex-wrap:wrap; }
  .item a.title { color:var(--fg); text-decoration:none; font-weight:600; font-size:1.02rem; }
  .item a.title:hover { color:var(--accent); text-decoration:underline; }
  .badge { font-size:.65rem; font-weight:700; text-transform:uppercase; letter-spacing:.03em;
    padding:2px 6px; border-radius:6px; color:#fff; white-space:nowrap; }
  .badge.rss{background:var(--badge-rss);} .badge.youtube{background:var(--badge-youtube);}
  .badge.github{background:var(--badge-github);} .badge.imap{background:var(--badge-imap);}
  .age { color:var(--muted); font-size:.78rem; }
  .src { color:var(--muted); font-size:.78rem; }
  .snippet { color:var(--muted); font-size:.9rem; margin-top:6px; }
  .also { color:var(--muted); font-size:.78rem; margin-top:4px; font-style:italic; }

  .overview { background:var(--card); border:1px solid var(--border); border-left:3px solid var(--accent);
    border-radius:10px; padding:12px 14px; margin-bottom:24px; font-size:.95rem; line-height:1.55; }
  .overview .ov-label { font-size:.68rem; text-transform:uppercase; letter-spacing:.08em; color:var(--muted);
    display:block; margin-bottom:4px; }
  .gist { font-size:.92rem; margin-top:4px; color:var(--fg); }
  .tracker .label a { color:var(--muted); text-decoration:none; }
  .tracker .label a:hover { color:var(--accent); }
  details.more { margin-top:5px; }
  details.more > summary { cursor:pointer; color:var(--accent); font-size:.78rem; list-style:none; }
  details.more > summary::-webkit-details-marker { display:none; }
  details.more > summary::before { content:"▸ details"; }
  details.more[open] > summary::before { content:"▾ less"; }

  /* per-type summary blocks */
  .type { margin-bottom:8px; }
  h2.section .count { color:var(--muted); font-weight:400; font-size:.85rem; }
  .type-summary { font-size:.98rem; line-height:1.6; margin:2px 0 8px; }
  .type-summary a { color:var(--accent); text-decoration:none; font-weight:600;
    font-variant-numeric:tabular-nums; padding:0 1px; }
  .type-summary a:hover { text-decoration:underline; }
  .top-pick { font-size:.95rem; margin:2px 0 10px; line-height:1.5; }
  .top-pick .star { color:#e8a53d; }
  .top-pick a { color:var(--fg); font-weight:650; text-decoration:none; }
  .top-pick a:hover { color:var(--accent); text-decoration:underline; }
  .top-pick .tp-gist { color:var(--muted); }
  details.items-drawer { margin:2px 0 10px; }
  details.items-drawer > summary { cursor:pointer; color:var(--accent); font-size:.8rem;
    list-style:none; padding:2px 0; }
  details.items-drawer > summary::-webkit-details-marker { display:none; }
  details.items-drawer > summary::before { content:"▸ "; }
  details.items-drawer[open] > summary::before { content:"▾ "; }
  .drawer-body { border-left:2px solid var(--border); padding-left:12px; margin-top:6px; }
  .iline { padding:7px 0; border-bottom:1px solid var(--border); }
  .iline:last-child { border-bottom:none; }
  .iline a, .iline .t { font-weight:550; font-size:.95rem; color:var(--fg); text-decoration:none; }
  .iline a:hover { color:var(--accent); text-decoration:underline; }
  .iline .iline-gist { font-size:.88rem; color:var(--fg); opacity:.82; margin-top:3px; }
  .iline .iline-meta { color:var(--muted); font-size:.78rem; margin-top:3px; }
  .new-pill { font-size:.6rem; font-weight:700; text-transform:uppercase; letter-spacing:.05em;
    color:#fff; background:var(--accent); border-radius:4px; padding:1px 5px; vertical-align:middle; }
  .iline.unseen { border-left:2px solid var(--accent); margin-left:-14px; padding-left:12px; }
  .unseen-note { display:inline-block; margin-top:6px; font-size:.72rem; font-weight:600; color:var(--accent);
    background:var(--card); border:1px solid var(--border); border-radius:999px; padding:2px 10px; }

  .dead { margin-top:36px; background:var(--card); border:1px solid var(--border);
    border-radius:12px; padding:12px 14px; }
  .dead h2 { font-size:.8rem; text-transform:uppercase; color:#dc2626; margin:0 0 8px; }
  .dead code { font-size:.78rem; color:var(--muted); }
  footer { margin-top:40px; color:var(--muted); font-size:.75rem; text-align:center; }
</style>
</head>
<body>
{% set SECTION_NAMES = {'watching': '📺 Watching', 'aws': 'AWS', 'dataeng': 'Data Engineering', 'ai': 'AI', 'releases': '📦 Releases', 'newsletters': 'Newsletters', 'lakehouse': 'Lakehouse'} %}
<div class="wrap">
  <header class="topbar">
    <div>
      <h1>Morning Digest</h1>
      <div class="sub">{{ generated_local }} · {{ counts.news }} items · {{ counts.newsletters }} newsletters<span class="fresh" id="fresh" data-generated="{{ generated_iso }}"></span></div>
      <div class="unseen-note" id="unseenNote" hidden></div>
    </div>
    <button class="theme-btn" id="themeBtn" title="Toggle light / dark" aria-label="Toggle theme">◐</button>
  </header>

  {% set nav = [] %}
  {% for s in sections %}{% if s.entries %}{% set _ = nav.append((s.tag, 'sec-' ~ s.tag)) %}{% endif %}{% endfor %}
  {% if newsletters %}{% set _ = nav.append(('newsletters', 'sec-newsletters')) %}{% endif %}
  {% if nav %}
  <nav class="jump" aria-label="Jump to section">
    {% if trackers %}<a href="#trackers">Trackers</a>{% endif %}
    {% for label, anchor in nav %}<a href="#{{ anchor }}">{{ SECTION_NAMES.get(label, label) }}</a>{% endfor %}
  </nav>
  {% endif %}

  {% if overview %}
  <div class="overview">
    <span class="ov-label">Today{% if today_label %} · {{ today_label }}{% endif %}</span>{{ overview }}
  </div>
  {% endif %}

  {% macro tracker_card(t) %}
    <div class="tracker{% if t.alert %} alert{% endif %}"{% if t.alert %} style="border-color:{{ t.alert }}"{% endif %}>
      <div class="label">{% if t.link %}<a href="{{ t.link }}" target="_blank" rel="noopener" title="Open a larger time-window view">{{ t.label }} ↗</a>{% else %}{{ t.label }}{% endif %}</div>
      <div class="value-row">
        <span class="value">{% if t.icon %}{{ t.icon }} {% endif %}{{ t.value }}</span>
        {% if t.delta and t.delta.dir != 'flat' %}<span class="delta {{ t.delta.dir }}" title="vs previous reading">{{ t.delta.arrow }} {{ t.delta.pct }}</span>{% endif %}
      </div>
      {% if t.band %}<div class="band"><span class="dot" style="background:{{ t.band.color }}"></span>{{ t.band.label }}</div>{% endif %}
      {% if t.cond %}<div class="tcond">{{ t.cond.icon }} {{ t.cond.label }}</div>{% endif %}
      {% if t.sub %}<div class="tsub">{{ t.sub }}</div>{% endif %}
      {% if t.spark %}
      <svg class="spark" viewBox="0 0 {{ t.spark.w }} {{ t.spark.h }}" preserveAspectRatio="none" aria-hidden="true">
        <polygon points="{{ t.spark.area }}" class="spark-area"/>
        <polyline points="{{ t.spark.line }}" class="spark-line"/>
        <circle cx="{{ t.spark.cx }}" cy="{{ t.spark.cy }}" r="2.4" class="spark-dot"/>
      </svg>
      {% endif %}
    </div>
  {% endmacro %}

  {% if trackers %}
  <div id="trackers">
    {% for gname in ['Markets', 'Environment', 'Other'] %}
    {% set gt = trackers | selectattr('group', 'equalto', gname) | list %}
    {% if gt %}
    <div class="tgroup-label">{{ gname }}</div>
    <div class="trackers">{% for t in gt %}{{ tracker_card(t) }}{% endfor %}</div>
    {% endif %}
    {% endfor %}
  </div>
  {% endif %}

  {% macro item_block(it) %}
  <div class="item">
    <div class="top">
      <span class="badge {{ it.source_type }}">{{ it.source_type }}</span>
      {% if it.url %}
      <a class="title" href="{{ it.url }}" target="_blank" rel="noopener">{{ it.title }}</a>
      {% else %}
      <span class="title">{{ it.title }}</span>
      {% endif %}
      <span class="age">· {{ it.age }} ago</span>
      <span class="src">· {{ it.source_id }}</span>
    </div>
    {% if it.summary %}
      <div class="gist">{{ it.summary }}</div>
      {% if it.snippet %}<details class="more"><summary></summary><div class="snippet">{{ it.snippet }}</div></details>{% endif %}
    {% elif it.snippet %}
      <div class="snippet">{{ it.snippet }}</div>
    {% endif %}
    {% if it.siblings %}<div class="also">also covered by: {{ it.siblings | join(", ") }}</div>{% endif %}
  </div>
  {% endmacro %}

  {% macro item_line(it) %}
  <div class="iline" data-pub="{{ it.published_iso }}">
    {% if it.is_new %}<span class="new-pill">new</span> {% endif %}{% if it.url %}<a href="{{ it.url }}" target="_blank" rel="noopener">{{ it.title }}</a>
    {% else %}<span class="t">{{ it.title }}</span>{% endif %}
    {% if it.summary %}<div class="iline-gist">{{ it.summary }}</div>{% endif %}
    <div class="iline-meta"><span class="badge {{ it.source_type }}">{{ it.source_type }}</span>
      {{ it.source_id }} · {{ it.age }} ago{% if it.siblings %} · also: {{ it.siblings | join(", ") }}{% endif %}</div>
  </div>
  {% endmacro %}

  {% macro type_block(display, tag, summary_html, top_pick, entries) %}
  <section class="type" id="sec-{{ tag }}">
    <h2 class="section">{{ display }} <span class="count">· {{ entries | length }}</span></h2>
    {% if summary_html %}<p class="type-summary">{{ summary_html }}</p>{% endif %}
    {% if top_pick %}
    <div class="top-pick"><span class="star" title="Top pick">★</span> {% if top_pick.url %}<a href="{{ top_pick.url }}" target="_blank" rel="noopener">{{ top_pick.title }}</a>{% else %}{{ top_pick.title }}{% endif %}{% if top_pick.summary %} <span class="tp-gist">— {{ top_pick.summary }}</span>{% endif %}</div>
    {% endif %}
    {% if entries %}
    <details class="items-drawer"{% if not summary_html %} open{% endif %}>
      <summary>{{ entries | length }} item{{ 's' if entries | length != 1 }}</summary>
      <div class="drawer-body">
        {% for it in entries %}{{ item_line(it) }}{% endfor %}
      </div>
    </details>
    {% endif %}
  </section>
  {% endmacro %}

  {% macro releases_block(display, tag, summary_html, entries) %}
  <section class="type" id="sec-{{ tag }}">
    <h2 class="section">{{ display }} <span class="count">· {{ entries | length }}</span></h2>
    {% if summary_html %}<p class="type-summary">{{ summary_html }}</p>{% endif %}
    {% if entries %}
    <div class="drawer-body">{% for it in entries %}{{ item_line(it) }}{% endfor %}</div>
    {% endif %}
  </section>
  {% endmacro %}

  {% for section in sections %}{% if section.tag == 'releases' %}{{ releases_block(SECTION_NAMES.get(section.tag, section.tag), section.tag, section.summary_html, section.entries) }}{% else %}{{ type_block(SECTION_NAMES.get(section.tag, section.tag), section.tag, section.summary_html, section.top_pick, section.entries) }}{% endif %}{% endfor %}
  {% if newsletters %}{{ type_block('Newsletters', 'newsletters', newsletter_summary_html, none, newsletters) }}{% endif %}

  {% if not sections and not newsletters %}
  <p style="color:var(--muted)">Nothing in the digest window. Feeds may be quiet, or run the fetchers.</p>
  {% endif %}

  {% if dead_feeds %}
  <div class="dead">
    <h2>⚠ dead feeds ({{ dead_feeds | length }})</h2>
    {% for d in dead_feeds %}
    <div><strong>{{ d.source_id }}</strong> — {{ d.error_count }} consecutive errors<br>
      <code>{{ d.last_error }}</code></div>
    {% endfor %}
  </div>
  {% endif %}

  <footer>Deterministic ranking &amp; dedup · summaries by Gemini · personal-digest-tracker</footer>
</div>
<script>
(function () {
  var root = document.documentElement;
  function pref() { return matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"; }
  try { var s = localStorage.getItem("pdt-theme"); if (s) root.setAttribute("data-theme", s); } catch (e) {}
  var btn = document.getElementById("themeBtn");
  if (btn) btn.addEventListener("click", function () {
    var next = (root.getAttribute("data-theme") || pref()) === "dark" ? "light" : "dark";
    root.setAttribute("data-theme", next);
    try { localStorage.setItem("pdt-theme", next); } catch (e) {}
  });
  var f = document.getElementById("fresh");
  if (f) {
    var g = Date.parse(f.getAttribute("data-generated"));
    if (!isNaN(g)) {
      var mins = Math.max(0, Math.round((Date.now() - g) / 60000));
      var t = mins < 1 ? "just now" : mins < 60 ? mins + "m ago"
            : mins < 1440 ? Math.round(mins / 60) + "h ago" : Math.round(mins / 1440) + "d ago";
      f.textContent = "generated " + t;
    }
  }
  // new-since-your-last-visit
  try {
    var LV = parseInt(localStorage.getItem("pdt-last-visit") || "0", 10);
    var unseen = 0;
    if (LV > 0) {
      document.querySelectorAll(".iline[data-pub]").forEach(function (el) {
        var p = Date.parse(el.getAttribute("data-pub"));
        if (!isNaN(p) && p > LV) { el.classList.add("unseen"); unseen++; }
      });
    }
    var un = document.getElementById("unseenNote");
    if (un && unseen > 0) { un.textContent = unseen + " new since your last visit"; un.hidden = false; }
    localStorage.setItem("pdt-last-visit", String(Date.now()));
  } catch (e) {}
  // PWA: register the service worker (offline / installable)
  if ("serviceWorker" in navigator) {
    window.addEventListener("load", function () {
      navigator.serviceWorker.register("sw.js").catch(function () {});
    });
  }
})();
</script>
</body>
</html>
